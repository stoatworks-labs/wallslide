{
  "name": "wallslide",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Generate correctly sized, themed PowerPoint templates and test decks for an LED wall — slide size, brand theme, slide master and diagnostic patterns, all built in the browser.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && npx wrangler deploy",
    "serve:dist": "python3 scripts/serve-dist.py --dir dist --port 4321",
    "samples": "rolldown scripts/emit-samples.ts --format esm --platform node --file .wrangler/emit-samples.mjs && node .wrangler/emit-samples.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.0.4",
    "jsdom": "^30.0.1",
    "typescript": "^5.6.3",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
